MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:3000
SESSION_SECRET=<generate-at-least-32-random-bytes>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password>
SMTP_FROM=<verified-sender-address>
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<generate-a-scrypt-hash-for-your-admin-password>
